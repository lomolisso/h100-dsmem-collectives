diff --git a/src/roofline_hooks.cuh b/src/roofline_hooks.cuh
new file mode 100644
index 0000000..a0881bf
--- /dev/null
+++ b/src/roofline_hooks.cuh
@@ -0,0 +1,48 @@
+// Roofline-study hooks (h100-dsmem-collectives roofline/patches/credit__roofline_hooks.patch).
+// Controlled by environment variables; with none set the binary behaves exactly as upstream.
+//   ROOFLINE_FLUSH_L2_MB=N          before every launch in time_kernel, run roofline_l2_flush_kernel: a read of
+//                                   a clean N-MB buffer, so the timed kernel finds neither useful nor dirty lines
+//                                   in L2 (the upstream loop launches back to back with a warm L2).
+//   ROOFLINE_BLOCK_VARIANT=read|smem  benchmark and verify only that one-CTA-per-row kernel (upstream runs both
+//                                   and keeps the faster one).
+#pragma once
+#include <cstdlib>
+#include <cstring>
+#include <cuda_runtime.h>
+
+namespace roofline_hooks {
+
+__global__ void roofline_l2_flush_kernel(const int4* __restrict__ buf, size_t n, int* sink) {
+    int acc = 0;
+    for (size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x; i < n;
+         i += static_cast<size_t>(gridDim.x) * blockDim.x) {
+        const int4 v = __ldcg(buf + i);
+        acc ^= v.x ^ v.y ^ v.z ^ v.w;
+    }
+    if (acc == 0x5eed1e55) *sink = acc;  // never true for the zeroed buffer; keeps the loads alive
+}
+
+inline void flush_l2() {
+    static const size_t mb = [] {
+        const char* v = std::getenv("ROOFLINE_FLUSH_L2_MB");
+        return v ? static_cast<size_t>(std::strtoull(v, nullptr, 10)) : size_t{0};
+    }();
+    if (mb == 0) return;
+    static int4* buf = nullptr;
+    static int* sink = nullptr;
+    const size_t n = mb * (1u << 20) / sizeof(int4);
+    if (buf == nullptr) {
+        if (cudaMalloc(&buf, n * sizeof(int4)) != cudaSuccess || cudaMalloc(&sink, sizeof(int)) != cudaSuccess ||
+            cudaMemset(buf, 0, n * sizeof(int4)) != cudaSuccess || cudaDeviceSynchronize() != cudaSuccess) {
+            std::abort();
+        }
+    }
+    roofline_l2_flush_kernel<<<4 * 132, 1024>>>(buf, n, sink);
+}
+
+inline bool block_enabled(const char* name) {
+    const char* v = std::getenv("ROOFLINE_BLOCK_VARIANT");
+    return v == nullptr || *v == '\0' || std::strcmp(v, name) == 0;
+}
+
+}  // namespace roofline_hooks
